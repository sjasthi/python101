#!/bin/sh
# Python 101 branding check: blocks a commit that adds files breaking BRANDING.md.
# Turn on once per clone:  git config core.hooksPath .githooks
if command -v python3 >/dev/null 2>&1 && python3 -c "" >/dev/null 2>&1; then
  PY=python3
else
  PY=python
fi
exec "$PY" tools/check_branding.py --staged
